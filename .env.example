# Supabase form storage config for local API/function testing and deployment.
# Set these in Netlify/Vercel environment variables; do not commit real keys.

# Required for contact and newsletter storage.
SUPABASE_URL=https://your-project-ref.supabase.co

# Preferred server-only key for backend inserts. Never expose this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=

# Safe fallback when you want handlers to insert through anon RLS policies.
# The migration grants anon INSERT only and keeps SELECT/UPDATE/DELETE denied.
SUPABASE_ANON_KEY=

# Photo to Text / OCR NVIDIA Vision config.
# Required server-only key for the Photo to Text API route. Never expose it in frontend code.
PHOTO_TO_TEXT_API_KEY=

# Optional fallback key name used by the Photo to Text route.
NVIDIA_API_KEY=

# Photo to Text uses NVIDIA chat completions with model meta/llama-3.2-11b-vision-instruct
# and endpoint https://integrate.api.nvidia.com/v1/chat/completions.
